{
  "functions": {
    "source": ".",
    "codebase": "default",
    "runtime": "nodejs20",
    "memory": "512MB",
    "timeoutSeconds": 120,
    "minInstances": 1,
    "ignore": [
      "node_modules",
      "node-v20*",
      "node-v22*",
      ".git",
      ".antigravity",
      ".agents",
      ".agents/**",
      ".firebase",
      ".firebase/**",
      "scratch",
      "downloads",
      "downloads/**",
      "downloads_temp",
      "downloads_temp/**",
      "ios",
      "ios/**",
      "android",
      "android/**",
      "mobile",
      "mobile/**",
      "scripts",
      "scripts/**",
      "src",
      "src/**",
      "ver",
      "**/ver/**",
      "assets",
      "**/assets/**",
      "*.map",
      "**/*.map",
      "build",
      "build/**",
      "screenshot.png",
      "firebase-debug.log"
    ]
  },
  "hosting": {
    "public": "dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.{js,css,woff,woff2,ttf,svg,png,jpg,webp,ico}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400, stale-while-revalidate=3600"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0"
          },
          {
            "key": "Pragma",
            "value": "no-cache"
          },
          {
            "key": "Expires",
            "value": "0"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}